# Backend: fail-closed Entra authentication is the default.
AUTH_MODE=entra
SAP_MODE=mock
DATA_DIR=./data
COMPANY_CODE=1000
ALLOWED_GL_ACCOUNTS=400100,210000,660000
ALLOWED_COST_CENTRES=CC100,CC200
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
# Live SAP only; install requirements-azure.txt first.
SAP_BASE_URL=
SAP_APIM_SCOPE=
SAP_ACCOUNT=
# Model endpoint hosts must also be allowed by the network operator.
LLM_ALLOWED_HOSTS=
KEY_VAULT_URL=
# Frontend server only; do not prefix these with NEXT_PUBLIC_.
API_BASE_URL=http://127.0.0.1:8000
ENTRA_WEB_CLIENT_ID=
ENTRA_WEB_CLIENT_SECRET=
ENTRA_API_SCOPE=
ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/callback
SESSION_PASSWORD=
